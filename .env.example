# ============================================================
# 必填
# ============================================================
# 公开 Telegram 频道的用户名（t.me/ 后面那串字符，是字符串不是数字）。
# 频道需为公开、未开启「限制保存内容」，否则部署后内容为空。
CHANNEL=kemiaoshuoshuo

# ============================================================
# 语言与时区
# ============================================================
# 界面语言，Intl/BCP 47 格式，如 zh-CN、en
LOCALE=zh-CN
# 时区，用于日期格式化，如 Asia/Shanghai
TIMEZONE=Asia/Shanghai

# ============================================================
# 社交链接（页脚/页头展示）
# ============================================================
# 以下填用户名即可（自动拼成完整链接）
TELEGRAM=Kemeow0815
# TWITTER=miantiao_me
GITHUB=maochenyu-me
# 以下需填完整 URL
# DISCORD=https://DISCORD.com
# PODCAST=https://PODCAST.com
# MASTODON=mastodon.social/@Mastodon
# BLUESKY=bsky.app

# ============================================================
# 原始 HTML 注入（仅限可信管理员使用，原样输出到页面）
# ============================================================
# 页脚注入
FOOTER_INJECT=
# 页头注入。Base 主题始终加载；想换主题时加载且只能加载一个内置覆盖主题，
# 例如：HEADER_INJECT='<link rel="stylesheet" href="/themes/aria.css">'
# 全部内置主题路径、平台写法与安全说明见 THEMES.md
HEADER_INJECT=

# ============================================================
# SEO 开关
# ============================================================
# true 时给外链加 rel="nofollow"
NOFOLLOW=false
# true 时给页面加 meta robots noindex（不想被搜索引擎收录时开启）
NOINDEX=false

# ============================================================
# 界面
# ============================================================
# true 时隐藏频道描述
HIDE_DESCRIPTION=false

# ============================================================
# 高级（一般无需修改）
# ============================================================
# Telegram 数据抓取域名，代码默认 telegram.me；被墙/被屏蔽时可换镜像
# 如 telegram.dog。注意：修改后 RSS、静态资源路径都会跟随此域名
TELEGRAM_HOST=telegram.dog
# 静态资源代理前缀。留空（或未设置）默认 /static/；
# 设为空字符串 "" 则直接使用 Telegram 原始资源 URL
STATIC_PROXY=""
# 服务端适配器选择是自动的（Vercel / Cloudflare Workers / Netlify / Node / EdgeOne）。
# EdgeOne 通过 std-env 的 edgeone_pages provider 或平台注入的
# EDGEONE_PROJECT_ID / EO_MAKERS 自动检测。仅在需要强制覆盖时设置，
# 可选值如 cloudflare_workers
SERVER_ADAPTER="EdgeOne"
# 在内置默认白名单基础上追加静态代理目标域名，仅填主机名（不带协议/端口/路径），
# 英文逗号分隔，如 a.com,b.com。除非明确要改安全模型，否则不要放宽默认白名单
TARGET_WHITELIST=""
# Google 站内搜索绑定的站点域名，如 memo.miantiao.me
GOOGLE_SEARCH_SITE=""
# 手动指定标签列表，英文逗号分隔，如 标签A,标签B,标签C
TAGS=""
# 是否显示 Telegram 评论（true/false）
COMMENTS="true"
# 是否显示 Reactions（true/false）
REACTIONS="true"
# 自定义链接列表，格式：Title1,URL1;Title2,URL2;Title3,URL3;
LINKS=""
# 自定义导航列表，格式同上：Title1,URL1;Title2,URL2;Title3,URL3;
NAVS=""
# true 时美化 RSS 输出（加 XSL 样式表，浏览器打开更友好）
RSS_BEAUTIFY="true"
